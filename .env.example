# Pick ONE provider key (checked in this order). Google has a free tier: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# With no provider key, models go through the Vercel AI Gateway
# (needs AI Gateway billing enabled; locally run `vercel env pull` or set AI_GATEWAY_API_KEY).
AI_GATEWAY_API_KEY=

# Optional: require this code in the app before agents run (recommended for public URLs).
OFFICE_ACCESS_CODE=

# Optional model id overrides for the active provider.
MANAGER_MODEL=
WORKER_MODEL=

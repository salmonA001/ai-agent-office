# Local dev: either run `vercel env pull` (OIDC token) or set an AI Gateway key.
AI_GATEWAY_API_KEY=

# Optional: require this code in the app before agents run (recommended for public URLs).
OFFICE_ACCESS_CODE=

# Optional model overrides (Vercel AI Gateway "provider/model" ids).
MANAGER_MODEL=anthropic/claude-sonnet-5.5
WORKER_MODEL=anthropic/claude-haiku-5.5
